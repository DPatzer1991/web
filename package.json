{
  "name": "dns3lweb",
  "version": "0.0.0-semantically-released",
  "private": true,
  "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "semantic-pre-release": "npx semantic-release -e ./pre-release.js --debug",
    "semantic-release": "npx semantic-release -e ./release.js --debug",
    "dev:mock": "NUXT_PUBLIC_API_URL=http://localhost:3000/mock NUXT_PUBLIC_MOCK_AUTH=true nuxt dev",
    "dev:dex": "NUXT_PUBLIC_API_URL=http://localhost:3000/mock NUXT_PUBLIC_AUTH_URL=http://localhost:5556/auth/.well-known/openid-configuration nuxt dev"
  },
  "repository": "github:dns3l/web",
  "release": {
    "branches": [
      "['+([0-9])?(.{+([0-9]),x}).x",
      "master",
      "next",
      "next-major",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "ci": true
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^24.2.9",
    "typescript": "^5",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@lavamoat/preinstall-always-fail": "^2.1.1",
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.2",
    "autoprefixer": "^10.4.4",
    "daisyui": "2.37.0",
    "marked": "^4.0.18",
    "nuxt": "^4.5.2",
    "oidc-client-ts": "^3.5.0",
    "postcss": "^8.4.4",
    "rapidoc": "^9",
    "rehype-highlight": "^5.0.2",
    "rehype-sanitize": "^5.0.1",
    "rehype-stringify": "^9.0.3",
    "remark-gfm": "^3.0.1",
    "remark-parse": "^10.0.1",
    "remark-rehype": "^10.1.0",
    "tailwindcss": "^3.4.17",
    "underscore": "^1.13.6",
    "unified": "^10.1.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  }
}
